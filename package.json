{
  "name": "fontem-mcp-server",
  "version": "1.0.0",
  "description": "MCP server for the GMR EU Knowledge Graph \u2014 gives LLMs access to company, procurement, lobbying, and graph data",
  "type": "module",
  "main": "src/index.js",
  "bin": {
    "gmr-mcp": "src/index.js"
  },
  "scripts": {
    "start": "node src/index.js",
    "test": "node --test",
    "test:coverage": "node --test --experimental-test-coverage --test-reporter=lcov --test-reporter-destination=lcov.info"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.31.0"
  },
  "overrides": {
    "hono": "^4.13.5",
    "fast-uri": "^4.1.5",
    "ip-address": "^10.5.1",
    "brace-expansion@1": "5.0.8",
    "brace-expansion@2": "5.0.8",
    "brace-expansion@5": "5.0.8",
    "proxy-addr": "^2.0.8",
    "qs": "^6.16.0"
  }
}
